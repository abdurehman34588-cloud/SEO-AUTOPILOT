generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Audit {
  id              String             @id @default(cuid())
  url             String
  normalizedUrl   String
  status          String             @default("pending") // pending, running, completed, failed
  score           Int                @default(0)
  technicalScore  Int                @default(0)
  onPageScore     Int                @default(0)
  contentScore    Int                @default(0)
  linksScore      Int                @default(0)
  isDemo          Boolean            @default(false)
  summary         String?
  createdAt       DateTime           @default(now())
  completedAt     DateTime?
  pages           Page[]
  issues          Issue[]
  recommendations AIRecommendation[]
}

model Page {
  id                String   @id @default(cuid())
  auditId           String
  url               String
  statusCode        Int      @default(200)
  title             String?
  metaDescription   String?
  canonical         String?
  h1Count           Int      @default(0)
  h2Count           Int      @default(0)
  wordCount         Int      @default(0)
  imageCount        Int      @default(0)
  missingAltCount   Int      @default(0)
  internalLinkCount Int      @default(0)
  externalLinkCount Int      @default(0)
  responseTimeMs    Int      @default(0)
  audit             Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  issues            Issue[]
}

model Issue {
  id             String  @id @default(cuid())
  auditId        String
  pageId         String?
  category       String  // TECHNICAL, ON_PAGE, CONTENT, LINKS
  severity       String  // critical, warning, info
  status         String  // pass, warning, fail
  title          String
  description    String
  recommendation String
  evidence       String?
  audit          Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  page           Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model AIRecommendation {
  id            String  @id @default(cuid())
  auditId       String
  priority      Int     @default(1)
  title         String
  description   String
  impact        String  @default("medium") // high, medium, low
  difficulty    String  @default("medium") // easy, medium, hard
  affectedPages String?
  audit         Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
}
